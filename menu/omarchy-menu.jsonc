  // >>> cortex-control-omarchy: managed by cortex-control-setup; removed by cortex-control-uninstall
  "learn.quad-cortex-keys": {"icon":"","label":"Quad Cortex","description":"Cortex Control keyboard shortcuts","when":"command -v cortex-control >/dev/null","action":"cortex-control --keys --menu"},
  "trigger.quad-cortex": {"icon":"󰥛","label":"Quad Cortex","description":"Cortex Control, tuner, modes, audio","when":"command -v cortex-control >/dev/null"},
  "trigger.quad-cortex.editor": {"icon":"󰥛","label":"Show or hide Cortex Control","action":"cortex-control --toggle"},
  "trigger.quad-cortex.tuner": {"icon":"󰎇","label":"Tuner on/off","when":"cortex-control-qc midi-status | jq -e .present >/dev/null","checked":"cortex-control-qc midi-status | jq -e .tunerOpen >/dev/null","action":"cortex-control-qc --osd tuner toggle"},
  "trigger.quad-cortex.mode": {"icon":"󰘮","label":"Mode","when":"cortex-control-qc midi-status | jq -e .present >/dev/null"},
  "trigger.quad-cortex.mode.preset": {"icon":"󰥛","label":"Preset","checked":"cortex-control-qc midi-status | jq -e '.mode == 0' >/dev/null","action":"cortex-control-qc --osd mode preset"},
  "trigger.quad-cortex.mode.scene": {"icon":"󰥛","label":"Scene","checked":"cortex-control-qc midi-status | jq -e '.mode == 1' >/dev/null","action":"cortex-control-qc --osd mode scene"},
  "trigger.quad-cortex.mode.stomp": {"icon":"󰥛","label":"Stomp","checked":"cortex-control-qc midi-status | jq -e '.mode == 2' >/dev/null","action":"cortex-control-qc --osd mode stomp"},
  "trigger.quad-cortex.pro-audio": {"icon":"󰋋","label":"Pro Audio (for DAWs)","when":"cortex-control-qc audio-status | jq -e .present >/dev/null","checked":"cortex-control-qc audio-status | jq -e .proAudio >/dev/null","action":"if cortex-control-qc audio-status | jq -e .proAudio >/dev/null; then cortex-control-qc pro-audio off; else cortex-control-qc pro-audio on; fi"},
  "trigger.quad-cortex.keys": {"icon":"","label":"Keyboard shortcuts","action":"cortex-control --keys --menu"},
  "trigger.quad-cortex.doctor": {"icon":"󰛯","label":"Doctor","action":"omarchy-launch-floating-terminal-with-presentation cortex-control-doctor"},
  // <<< cortex-control-omarchy
