  // >>> stompgate: managed by stompgate-setup; removed by stompgate-uninstall
  "learn.stompgate": {"icon":"","label":"Stompgate","description":"Quad Cortex and Cortex Control keyboard shortcuts","when":"command -v stompgate >/dev/null","action":"stompgate --keys --menu"},
  "trigger.stompgate": {"icon":"󰥛","label":"Stompgate","description":"Quad Cortex: Cortex Control, tuner, modes, audio","when":"command -v stompgate >/dev/null"},
  "trigger.stompgate.editor": {"icon":"󰥛","label":"Show or hide Cortex Control","action":"stompgate --toggle"},
  "trigger.stompgate.quit": {"icon":"󰅖","label":"Quit Cortex Control","when":"pgrep -f '[C]ortex Control\\.exe' >/dev/null","action":"stompgate --quit"},
  "trigger.stompgate.tuner": {"icon":"󰎇","label":"Tuner on/off","when":"stompgate-qc midi-status | jq -e .present >/dev/null","checked":"stompgate-qc midi-status | jq -e .tunerOpen >/dev/null","action":"stompgate-qc --osd tuner toggle"},
  "trigger.stompgate.mode": {"icon":"󰘮","label":"Mode","when":"stompgate-qc midi-status | jq -e .present >/dev/null"},
  "trigger.stompgate.mode.preset": {"icon":"󰥛","label":"Preset","checked":"stompgate-qc midi-status | jq -e '.mode == 0' >/dev/null","action":"stompgate-qc --osd mode preset"},
  "trigger.stompgate.mode.scene": {"icon":"󰥛","label":"Scene","checked":"stompgate-qc midi-status | jq -e '.mode == 1' >/dev/null","action":"stompgate-qc --osd mode scene"},
  "trigger.stompgate.mode.stomp": {"icon":"󰥛","label":"Stomp","checked":"stompgate-qc midi-status | jq -e '.mode == 2' >/dev/null","action":"stompgate-qc --osd mode stomp"},
  "trigger.stompgate.pro-audio": {"icon":"󰋋","label":"Pro Audio (for DAWs)","when":"stompgate-qc audio-status | jq -e .present >/dev/null","checked":"stompgate-qc audio-status | jq -e .proAudio >/dev/null","action":"if stompgate-qc audio-status | jq -e .proAudio >/dev/null; then stompgate-qc pro-audio off; else stompgate-qc pro-audio on; fi"},
  "trigger.stompgate.keys": {"icon":"","label":"Keyboard shortcuts","action":"stompgate --keys --menu"},
  "trigger.stompgate.doctor": {"icon":"󰛯","label":"Doctor","action":"omarchy-launch-floating-terminal-with-presentation stompgate-doctor"},
  // <<< stompgate
