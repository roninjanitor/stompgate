#!/bin/bash

# Launch Neural DSP Cortex Control through umu-launcher and the pinned GE-Proton,
# or focus its window if it is already running.

set -euo pipefail

_here="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
if [[ -f $_here/../lib/stompgate.sh ]]; then
  source "$_here/../lib/stompgate.sh"
else
  source /usr/share/stompgate/lib/stompgate.sh
fi

# Our shortcuts as Hyprland currently has them, so edits to the keys show up
# here, in the bar widget and in Omarchy's keybindings menu alike.
current_keys() {
  omarchy-menu-keybindings --print 2>/dev/null |
    awk -F ' *→ *' '
      BEGIN { name["SUPER"] = "Super"; name["ALT"] = "Alt"; name["CTRL"] = "Ctrl"; name["SHIFT"] = "Shift" }
      $2 ~ /^Stompgate: / {
        # "SUPER ALT + B" -> "Super + Alt + B"
        n = split($1, parts, /[ +]+/); keys = ""
        for (i = 1; i <= n; i++) if (parts[i] != "") keys = keys (keys == "" ? "" : " + ") (parts[i] in name ? name[parts[i]] : parts[i])
        print keys "\t" $2
      }'
}

show_keys() {
  local fmt="${1:-text}" rows
  rows=$(current_keys)
  case "$fmt" in
    --json)
      jq -R -s -c 'split("\n") | map(select(length > 0) | split("\t") | {keys: .[0], action: .[1]})' <<<"$rows"
      ;;
    --menu)
      local change="Change these keys…" choice
      choice=$( { awk -F '\t' '{ printf "%-28s %s\n", $1, $2 }' <<<"$rows"; echo "$change"; } |
        omarchy-menu-select "Stompgate keys" -- --width 720 --height 460) || exit 0
      [[ $choice == "$change" ]] && exec omarchy-launch-editor "$HYPR_RULE_FILE"
      ;;
    *)
      if [[ -z $rows ]]; then
        echo "No Cortex Control shortcuts are bound. Run stompgate-setup to add them."
      else
        awk -F '\t' '{ printf "  %-28s %s\n", $1, $2 }' <<<"$rows"
        echo
        echo "Change them in $HYPR_RULE_FILE (Hyprland reloads on save)."
      fi
      ;;
  esac
}

# The X display Cortex Control draws on: gamescope's own nested one in
# gamescope mode, XWayland's otherwise. umu-run's environment has it; the app's
# own is remapped inside umu's container.
app_display() {
  local pid
  for pid in $(pgrep -x umu-run); do
    if tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null | grep -qF 'Cortex Control.exe'; then
      tr '\0' '\n' <"/proc/$pid/environ" 2>/dev/null | sed -n 's/^DISPLAY=//p'
      return
    fi
  done
}

# Close Cortex Control the way its window's close button would, so it can let
# go of the QC cleanly. Only with --force, for an app that's stuck, does this
# end the whole Wine session instead.
quit_app() {
  local force=0 timeout=15 window class display i
  [[ ${1:-} == --force ]] && force=1
  if ! app_running; then
    [[ -t 1 ]] && echo "Cortex Control isn't running."
    return 0
  fi

  if (( force )); then
    WINEPREFIX="$PREFIX" "$PROTON_DIR/files/bin/wineserver" -k 2>/dev/null || true
  else
    window=$(hyprctl clients -j 2>/dev/null | jq -c "[.[] | $WINDOW_JQ][0] // empty")
    class=$(jq -r '.class // empty' <<<"${window:-null}")
    if [[ $class == "$WINDOW_CLASS" ]]; then
      # A normal XWayland window: Hyprland sends it WM_DELETE_WINDOW, even
      # while it's on the hidden workspace.
      hyprctl dispatch "hl.dsp.window.close({ window = \"address:$(jq -r '.address' <<<"$window")\" })" >/dev/null
    else
      # Inside gamescope, Hyprland only sees gamescope, and closing that kills
      # the app outright. Ask the app's window on gamescope's display instead.
      display=$(app_display)
      [[ -n $display ]] && python3 -I "$SHARE_DIR/lib/x11-close.py" "$display" "$WINDOW_CLASS" || true
    fi
  fi

  for (( i = 0; i < timeout * 4; i++ )); do
    if ! app_running; then
      osd "Editor closed"
      return 0
    fi
    sleep 0.25
  done
  if (( force )); then
    notify "Cortex Control is still running after stompgate --quit --force. Check: pgrep -af 'Cortex Control'"
  else
    notify "Cortex Control didn't close. If it's stuck, stop it with: stompgate --quit --force"
  fi
  return 1
}

mode="show"
case "${1:-}" in
  --keys) show_keys "${2:-}"; exit 0 ;;
  --quit) refuse_root; quit_app "${2:-}"; exit ;;
  --show) mode="show"; shift ;;
  --hide) mode="hide"; shift ;;
  --toggle) mode="toggle"; shift ;;
  -h | --help)
    cat <<'EOF'
Usage: stompgate [--show | --hide | --toggle | --quit [--force] | --keys [--json | --menu]]

Starts Cortex Control, or shows and focuses its window if it is already open.

  --show    Bring the window to the current workspace and focus it (default)
  --hide    Move the window to a hidden workspace. The app keeps running.
  --toggle  Hide the window if it's on the current workspace, otherwise show it
  --quit    Close Cortex Control, as its close button would, even while hidden.
            --force ends its whole Wine session; use it only if the app is stuck.
  --keys    List the keyboard shortcuts (--menu: Omarchy menu, --json: for scripts)

Related commands: stompgate-setup, stompgate-doctor, stompgate-qc, stompgate-uninstall
EOF
    exit 0
    ;;
esac

refuse_root

STARTUP_TIMEOUT=180 # seconds
STARTUP_OSD_MS=$(( STARTUP_TIMEOUT * 1000 ))

if [[ ! -f $APP || ! -x $PROTON_DIR/proton ]]; then
  # From the app launcher there is no terminal, so open one for the setup.
  if [[ ! -t 0 ]] && command -v omarchy-launch-floating-terminal-with-presentation >/dev/null; then
    exec omarchy-launch-floating-terminal-with-presentation stompgate-setup
  fi
  die "Cortex Control is not set up yet. Run: stompgate-setup"
fi

# Reuse an existing window instead of starting a second copy on the same QC.
window=$(hyprctl clients -j 2>/dev/null | jq -c "[.[] | $WINDOW_JQ][0] // empty")
if [[ -n $window ]]; then
  address=$(jq -r '.address' <<<"$window")
  window_ws=$(jq -r '.workspace.name' <<<"$window")
  active_ws=$(hyprctl activeworkspace -j | jq -r '.name')
  if [[ $mode == "toggle" ]]; then
    [[ $window_ws == "$active_ws" ]] && mode="hide" || mode="show"
  fi
  if [[ $mode == "hide" ]]; then
    hyprctl dispatch "hl.dsp.window.move({ window = \"address:$address\", workspace = \"$HIDDEN_WORKSPACE\", follow = false })" >/dev/null
  else
    if [[ $window_ws != "$active_ws" ]]; then
      hyprctl dispatch "hl.dsp.window.move({ window = \"address:$address\", workspace = \"$active_ws\", follow = false })" >/dev/null
    fi
    hyprctl dispatch "hl.dsp.focus({ window = \"address:$address\" })" >/dev/null
  fi
  exit 0
fi
[[ $mode == "hide" ]] && exit 0
# Started a moment ago and its window isn't up yet: say so rather than
# starting a second copy on the same QC.
starting_file="$STATE_DIR/starting"
if starter=$(cat "$starting_file" 2>/dev/null) && kill -0 "$starter" 2>/dev/null; then
  osd "Starting editor…" "$STARTUP_OSD_MS"
  exit 0
fi
if app_running; then
  notify "Cortex Control is still closing. Try again in a few seconds."
  exit 1
fi

# Cortex Control may ask PowerShell whether the network is up, and Wine's
# PowerShell is a stub. Check on the Linux side and hand the answer to the
# powershell.bat shim (taylortek91/cortex-control-wine).
online=0
if curl --fail --silent --head --connect-timeout 2 --max-time 5 "$CLOUD_CHECK_URL" >/dev/null 2>&1; then
  online=1
fi

mkdir -p "$STATE_DIR"
log="$STATE_DIR/last-run.log"

# The window takes several seconds to appear, so show that something is
# happening until it does, or say why it didn't. Runs alongside the launch;
# this script's PID becomes the app's once it execs.
watch_startup() {
  local launcher=$1 i
  set +e
  echo "$BASHPID" >"$starting_file"
  osd "Starting editor…" "$STARTUP_OSD_MS"
  for (( i = 0; i < STARTUP_TIMEOUT * 2; i++ )); do
    sleep 0.5
    if hyprctl clients -j 2>/dev/null | jq -e "[.[] | $WINDOW_JQ] | length > 0" >/dev/null; then
      osd_close
      break
    fi
    if ! kill -0 "$launcher" 2>/dev/null; then
      osd_close
      notify "Cortex Control closed before its window appeared. See $log, or run stompgate-doctor."
      break
    fi
  done
  if (( i == STARTUP_TIMEOUT * 2 )); then
    osd_close
    notify "Cortex Control's window still isn't showing after $((STARTUP_TIMEOUT / 60)) minutes. Run stompgate-doctor."
  fi
  rm -f "$starting_file"
}
watch_startup $$ </dev/null >/dev/null 2>&1 &
shim_dir="$SHARE_DIR/shims"

cd "$APP_DIR"
export WINEPREFIX="$PREFIX" PROTONPATH="$PROTON_DIR" GAMEID
export PROTON_ENABLE_HIDRAW="$QC_PROTON_HIDRAW"
export WINEPATH="Z:${shim_dir//\//\\}"
export STOMPGATE_HOST_ONLINE="$online"
export WINEDEBUG="${WINEDEBUG:--all}"
# Wine's Wayland driver gives the window a Windows-style frame and breaks
# resizing; keep it on XWayland.
unset PROTON_ENABLE_WAYLAND PROTON_USE_WAYLAND

launch=(umu-run "$APP" "$@")
mode=$(display_mode)
if [[ $mode == gamescope ]] && versions=$(gamescope_hidden_window_bug); then
  read -r gs_ver hl_ver <<<"$versions"
  notify "gamescope $gs_ver never shows its window on Hyprland $hl_ver, so Cortex Control is opening as a normal window. Run stompgate-doctor for the fix."
  mode=window
fi
if [[ $mode == gamescope ]]; then
  # Render at ~80% of the monitor's height and let gamescope scale that to the
  # tile with letterboxing ("fit"), so the UI is never cropped at any size.
  # Mostly shrinking (rather than enlarging) keeps text sharp.
  read -r mon_w mon_h < <(hyprctl monitors -j 2>/dev/null |
    jq -r '[.[] | select(.focused)][0] // .[0] | "\((.width / .scale) | floor) \((.height / .scale) | floor)"')
  height=$(( ${mon_h:-1080} * 8 / 10 ))
  width=$(awk -v h="$height" -v r="$APP_RATIO" 'BEGIN { printf "%d", h * r }')
  if (( width < APP_MIN_WIDTH )); then
    width=$APP_MIN_WIDTH
    height=$(awk -v w="$width" -v r="$APP_RATIO" 'BEGIN { printf "%d", w / r }')
  fi
  launch=(gamescope -w "$width" -h "$height" -W "$width" -H "$height" -S fit -F linear -- "${launch[@]}")
fi

if [[ -t 1 ]]; then
  "${launch[@]}" 2>&1 | tee "$log"
else
  exec "${launch[@]}" >"$log" 2>&1
fi
